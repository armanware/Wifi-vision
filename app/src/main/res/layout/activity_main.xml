<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#050B12">
    <androidx.camera.view.PreviewView android:id="@+id/previewView" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
    <com.armanware.wifivision.WifiOverlayView android:id="@+id/wifiOverlay" android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:orientation="vertical" android:padding="16dp" android:background="#D9101822">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📶 WiFi Vision" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="26sp" />
        <TextView android:id="@+id/modeText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AR CAMERA • LIVE SIGNAL FIELD" android:textColor="#26A7FF" android:textStyle="bold" android:textSize="12sp" />
        <TextView android:id="@+id/networkText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Reading Wi-Fi…" android:textColor="#FFFFFF" android:textSize="14sp" />
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:background="#E608111B" android:padding="10dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/cameraButton" android:layout_width="wrap_content" android:layout_height="56dp" android:text="AR View" />
            <Button android:id="@+id/heatmapButton" android:layout_width="wrap_content" android:layout_height="56dp" android:text="Heatmap" />
            <Button android:id="@+id/propagationButton" android:layout_width="wrap_content" android:layout_height="56dp" android:text="Propagation" />
            <Button android:id="@+id/surveyButton" android:layout_width="wrap_content" android:layout_height="56dp" android:text="● Survey" />
        </LinearLayout>
    </HorizontalScrollView>
</FrameLayout>
